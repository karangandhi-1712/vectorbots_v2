<?xml version="1.0"?>
<robot name="workcell_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="namespace" default="arm_01"/>
  <xacro:property name="ns" value="$(arg namespace)"/>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.3" length="0.5"/></geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.3" length="0.5"/></geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="1.5" ixy="0" ixz="0" iyy="1.5" iyz="0" izz="2.0"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry><cylinder radius="0.2" length="1.0"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry><cylinder radius="0.2" length="1.0"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="1.6" ixy="0" ixz="0" iyy="1.6" iyz="0" izz="0.4"/>
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="5.0" friction="1.0"/>
    <limit lower="-3.14" upper="3.14" effort="500" velocity="2.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 1.0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 2.0"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 1.0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 2.0"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 1.0" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="5.0" ixy="0" ixz="0" iyy="5.0" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 1.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="5.0" friction="1.0"/>
    <limit lower="-1.57" upper="1.57" effort="500" velocity="2.0"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.75" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 1.5"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.75" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 1.5"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.75" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.8" ixy="0" ixz="0" iyy="1.8" iyz="0" izz="0.05"/>
    </inertial>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 2.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="2.0" friction="0.5"/>
    <limit lower="-2.5" upper="2.5" effort="300" velocity="3.0"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <topic>/${ns}/joint1/cmd_pos</topic>
      <p_gain>10000</p_gain><d_gain>500</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint2</joint_name>
      <topic>/${ns}/joint2/cmd_pos</topic>
      <p_gain>10000</p_gain><d_gain>500</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint3</joint_name>
      <topic>/${ns}/joint3/cmd_pos</topic>
      <p_gain>8000</p_gain><d_gain>300</d_gain>
    </plugin>
  </gazebo>
</robot>