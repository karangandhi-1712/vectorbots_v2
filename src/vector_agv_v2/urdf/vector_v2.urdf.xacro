<?xml version="1.0"?>
<robot name="vector_v2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="namespace" default=""/>
  <xacro:property name="ns" value="$(arg namespace)"/>
  <xacro:property name="payload_mass" value="2000.0"/>

  <material name="heavy_orange">
    <color rgba="1.0 0.45 0.0 1.0"/>
  </material>
  <material name="steel">
    <color rgba="0.6 0.6 0.65 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="7.5 1.3 0.25"/></geometry>
      <material name="heavy_orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="7.5 1.3 0.15"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.5" rpy="0 0 0"/>
      <mass value="500.0"/>
      <inertia ixx="71.0" ixy="0.0" ixz="0.0" iyy="2344.0" iyz="0.0" izz="2414.0"/>
    </inertial>
  </link>

  <xacro:macro name="rod_column" params="x_val">
    <visual><origin xyz="${x_val} 0 0.5" rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="1.2"/></geometry><material name="steel"/></visual>
    <visual><origin xyz="${x_val} 0 0.8" rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="1.2"/></geometry><material name="steel"/></visual>
    <visual><origin xyz="${x_val} 0 1.1" rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="1.2"/></geometry><material name="steel"/></visual>
    <visual><origin xyz="${x_val} 0 1.4" rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="1.2"/></geometry><material name="steel"/></visual>
    <visual><origin xyz="${x_val} 0 1.7" rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="1.2"/></geometry><material name="steel"/></visual>
    <visual><origin xyz="${x_val} 0 2.0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.03" length="1.2"/></geometry><material name="steel"/></visual>
  </xacro:macro>

  <link name="payload_link">
    <visual>
      <origin xyz="3.0 0.5 0.15" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 0.3"/></geometry>
      <material name="steel"/>
    </visual>
    <visual>
      <origin xyz="3.0 -0.5 0.15" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 0.3"/></geometry>
      <material name="steel"/>
    </visual>
    <visual>
      <origin xyz="-3.0 0.5 0.15" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 0.3"/></geometry>
      <material name="steel"/>
    </visual>
    <visual>
      <origin xyz="-3.0 -0.5 0.15" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 0.3"/></geometry>
      <material name="steel"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.325" rpy="0 0 0"/>
      <geometry><box size="7.0 1.3 0.05"/></geometry>
      <material name="steel"/>
    </visual>

    <visual>
      <origin xyz="0 0.6 1.25" rpy="0 0 0"/>
      <geometry><box size="7.0 0.1 1.8"/></geometry>
      <material name="steel"/>
    </visual>

    <xacro:rod_column x_val="-3.0"/>
    <xacro:rod_column x_val="-2.4"/>
    <xacro:rod_column x_val="-1.8"/>
    <xacro:rod_column x_val="-1.2"/>
    <xacro:rod_column x_val="-0.6"/>
    <xacro:rod_column x_val="0.0"/>
    <xacro:rod_column x_val="0.6"/>
    <xacro:rod_column x_val="1.2"/>
    <xacro:rod_column x_val="1.8"/>
    <xacro:rod_column x_val="2.4"/>
    <xacro:rod_column x_val="3.0"/>

    <collision>
      <origin xyz="0 0 1.25" rpy="0 0 0"/>
      <geometry><box size="7.0 1.5 2.5"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -1.5" rpy="0 0 0"/>
      <mass value="${payload_mass}"/>
      <inertia 
        ixx="${(payload_mass/12.0) * (1.5*1.5 + 2.5*2.5)}" 
        ixy="0.0" ixz="0.0" 
        iyy="${(payload_mass/12.0) * (7.0*7.0 + 2.5*2.5)}" 
        iyz="0.0" 
        izz="${(payload_mass/12.0) * (7.0*7.0 + 1.5*1.5)}"/>
    </inertial>
  </link>
  <joint name="payload_joint" type="fixed">
    <parent link="base_link"/>
    <child link="payload_link"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="drive_wheel" params="prefix y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.2" length="0.1"/></geometry>
        <material name="pu_orange"><color rgba="1.0 0.4 0.0 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.2" length="0.1"/></geometry>
      </collision>
      <inertial>
        <mass value="50.0"/>
        <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="1.0"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${y_offset} -0.2" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${prefix}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="caster_wheel" params="prefix x_offset y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <geometry><sphere radius="0.19"/></geometry>
        <material name="pu_orange"><color rgba="1.0 0.4 0.0 1.0"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="0.19"/></geometry>
      </collision>
      <inertial>
        <mass value="20.0"/>
        <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_offset} ${y_offset} -0.2" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${prefix}_wheel">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="drive_left" y_offset="0.45"/>
  <xacro:drive_wheel prefix="drive_right" y_offset="-0.45"/>
  <xacro:caster_wheel prefix="front_left" x_offset="3.0" y_offset="0.45"/>
  <xacro:caster_wheel prefix="front_right" x_offset="3.0" y_offset="-0.45"/>
  <xacro:caster_wheel prefix="rear_left" x_offset="-3.0" y_offset="0.45"/>
  <xacro:caster_wheel prefix="rear_right" x_offset="-3.0" y_offset="-0.45"/>

  <link name="camera_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="4.3 0 0.8" rpy="0 1.5708 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <update_rate>10.0</update_rate>
      <camera>
        <horizontal_fov>2.5</horizontal_fov>
        <image>
          <width>160</width>
          <height>120</height>
        </image>
      </camera>
      <topic>/${ns}/camera/image_raw</topic>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>drive_left_joint</left_joint>
      <right_joint>drive_right_joint</right_joint>
      <wheel_separation>0.9</wheel_separation>
      <wheel_radius>0.2</wheel_radius>
      <topic>/${ns}/cmd_vel</topic>
      <max_linear_acceleration>10.0</max_linear_acceleration>
      <max_angular_acceleration>20.0</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/${ns}/joint_states</topic>
    </plugin>
  </gazebo>

</robot>