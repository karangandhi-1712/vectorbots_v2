        <visual name="visual">
          <geometry><box><size>220 40 0.001</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>220 40 0.001</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="left_red_curve"><static>true</static><pose>-90 0 0.001 0 0 0</pose><link name="link"><visual name="visual"><geometry><cylinder><radius>10.1</radius><length>0.001</length></cylinder></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link></model>
